#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_setting {
            bindings = <&tog 3>;
            key-positions = <37 36 48 49>;
        };

        combo_ctrl_space {
            bindings = <&kp LC(F9)>;
            key-positions = <52 55>;
        };

        combo_f8 {
            bindings = <&kp F8>;
            key-positions = <53 54>;
        };

        combo_colon {
            bindings = <&kp COLON>;
            key-positions = <28 34>;
        };

        combo_arraw {
            bindings = <&macro_arraw>;
            key-positions = <28 27>;
        };

        combo_arraw_eq {
            bindings = <&macro_arraw_eq>;
            key-positions = <16 15>;
        };

        combo_fj {
            bindings = <&kp LS(SPACE)>;
            key-positions = <28 31>;
        };

        combo_alt_shift_f8 {
            bindings = <&kp LA(LS(F8))>;
            key-positions = <38 39 40>;
        };
    };

    macros {
        macro_bracket_and_quotation: macro_bracket_and_quotation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp SQT>;
            label = "MACRO_BRACKET_AND_QUOTATION";
        };

        macro_quotation_and_bracket: macro_quotation_and_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp RIGHT_BRACKET>;
            label = "MACRO_QUOTATION_AND_BRACKET";
        };

        macro_arraw: macro_arraw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_ARRAW";
        };

        macro_arraw_eq: macro_arraw_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "MACRO_ARRAW_EQ";
        };

        macro_se: macro_se {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E>;
            label = "MACRO_SE";
        };

        macro_li: macro_li {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I>;
            label = "MACRO_LI";
        };

        macro_d_space: macro_d_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp SPACE>;
            label = "MACRO_D_SPACE";
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        lily-58 {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp MINUS   &kp N1          &kp N2          &kp N3              &kp N4            &kp N5                                                &kp N6       &kp N7             &kp N8               &kp N9           &kp N0              &kp EQUAL
&kp GRAVE   &kp Q           &kp W           &kp E               &kp R             &kp T                                                 &kp Y        &kp U              &kp I                &kp O            &kp P               &kp BACKSPACE
&kp ESCAPE  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F  &kp G                                                 &kp H        &hm RIGHT_SHIFT J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp LSHFT   &kp Z           &kp X           &kp C               &kp V             &kp B        &kp LBKT            &kp RBKT             &kp N        &kp M              &kp COMMA            &kp DOT          &kp FSLH            &kp DELETE
                                            &kp RA(TAB)         &lt 4 UNDERSCORE  &lt 1 SPACE  &mt LEFT_WIN TAB    &mt RIGHT_WIN ENTER  &lt 2 SPACE  &lt 5 MINUS        &kp RC(RS(TAB))
            >;

            label = "lily-58";
        };

        guide {
            bindings = <
&trans   &trans    &trans    &trans     &trans     &trans                        &trans          &trans                &trans                 &trans            &trans          &trans
&trans   &trans    &trans    &trans     &trans     &trans                        &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE   &trans          &kp BSPC
&kp ESC  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                        &kp LEFT_ARROW  &kp DOWN_ARROW        &kp UP_ARROW           &kp RIGHT_ARROW   &mt HOME PG_UP  &trans
&trans   &trans    &trans    &trans     &trans     &trans     &trans    &trans   &kp LESS_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GREATER_THAN  &mt END PG_DN   &trans
                             &trans     &trans     &kp SPACE  &trans    &kp RET  &kp SPACE       &kp C_PREV            &kp C_NEXT
            >;

            label = "HJKL";
        };

        symbols {
            bindings = <
&trans     &trans           &trans       &trans     &trans      &trans                                &trans          &trans         &trans     &trans     &trans     &trans
&kp GRAVE  &kp AMPERSAND    &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT                           &trans          &trans         &trans     &trans     &trans     &kp BSPC
&kp ESC    &kp EXCLAMATION  &kp ASTRK    &kp MINUS  &kp EQUAL   &kp TILDE                             &trans          &kp RSHFT      &kp RCTRL  &kp RALT   &kp RGUI   &kp ENTER
&kp LSHFT  &kp CARET        &kp SLASH    &kp PIPE   &kp BSLH    &kp UNDERSCORE  &kp LBKT    &kp RBKT  &kp UNDERSCORE  &kp BACKSLASH  &kp PIPE   &kp MINUS  &kp SLASH  &kp DEL
                                         &trans     &trans      &trans          &trans      &trans    &trans          &trans         &trans
            >;

            label = "!@#$";
        };

        setting {
            bindings = <
&trans          &trans        &trans        &trans        &trans        &trans                          &trans        &trans        &trans        &trans        &trans        &trans
&bt BT_CLR      &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans          &sys_reset    &trans        &trans        &trans        &bootloader   &trans    &trans  &bootloader   &trans        &trans        &trans        &sys_reset    &trans
                                            &trans        &trans        &trans        &trans    &trans  &trans        &trans        &trans
            >;

            label = "setting";
        };

        number {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "number";
            bindings = <
&kp LC(MINUS)   &kp LC(N1)  &kp LC(N2)  &kp LC(N3)  &kp LC(N4)  &kp LC(N5)                          &trans        &trans   &trans  &trans  &trans       &trans
&kp LC(GRAVE)   &kp LC(Q)   &kp LC(W)   &kp LC(E)   &kp LC(R)   &kp LC(T)                           &kp ASTERISK  &kp N7   &kp N8  &kp N9  &kp EQUAL    &kp BACKSPACE
&kp LC(ESCAPE)  &kp LC(A)   &kp LC(S)   &kp LC(D)   &kp LC(F)   &kp LC(G)                           &kp MINUS     &kp N4   &kp N5  &kp N6  &kp PERCENT  &kp ENTER
&kp LC(LSHFT)   &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(B)   &kp LC(LBKT)    &trans  &kp KP_PLUS   &kp N1   &kp N2  &kp N3  &kp SLASH    &none
                                        &trans      &trans      &trans      &kp TAB         &kp N0  &trans        &kp DOT  &trans
            >;

            label = "number";
        };

        Fn {
            bindings = <
&trans     &trans   &trans   &trans    &trans     &trans                    &trans  &trans     &trans     &trans    &trans    &trans
&trans     &kp F12  &kp F11  &kp F10   &kp F9     &trans                    &trans  &trans     &trans     &trans    &trans    &trans
&trans     &kp F4   &kp F3   &kp F2    &kp F1     &trans                    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp LSHFT  &kp F8   &kp F7   &kp F6    &kp F5     &trans  &trans    &trans  &trans  &trans     &trans     &trans    &trans    &trans
                             &kp LALT  &kp LCTRL  &trans  &trans    &trans  &trans  &trans     &trans
            >;

            label = "F123";
        };
    };
};
